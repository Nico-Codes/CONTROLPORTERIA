rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios del sistema (perfiles y roles). Solo lectura para el propio usuario;
    // escritura solo desde el backend (Admin SDK).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function autenticado() {
      return request.auth != null;
    }

    function perteneceAPlanta(plantaId) {
      return autenticado() && perfil().activo == true &&
        (perfil().rol == 'superadmin' || plantaId in perfil().plantas);
    }

    function puedeGestionar(plantaId) {
      return perteneceAPlanta(plantaId) &&
        (perfil().rol == 'superadmin' || perfil().rol == 'gerente');
    }

    // Cada usuario solo accede a las plantas asignadas en su perfil.
    match /plantas/{plantaId} {
      allow read: if perteneceAPlanta(plantaId);
      allow write: if false;

      // Subcolecciones de cada planta.
      match /{subcol}/{docId} {
        allow read: if perteneceAPlanta(plantaId);
        allow create, update, delete: if puedeGestionar(plantaId) && subcol != 'registros_ronda';
      }

      // Registros de auditoría: se crean desde la app, se eliminan en lotes.
      // No se permite modificar un registro existente.
      match /registros_ronda/{doc} {
        allow read: if perteneceAPlanta(plantaId);
        allow create: if perteneceAPlanta(plantaId);
        allow delete: if puedeGestionar(plantaId);
        allow update: if false;
      }
    }

    // Emisores de push: dispositivos y config (top-level, compartidos).
    match /dispositivos_notificaciones/{doc} {
      allow read, write: if autenticado();
    }

    match /config/{doc} {
      // La configuración global solo se administra desde la API con Admin SDK.
      allow read: if autenticado() && perfil().activo == true && perfil().rol == 'superadmin';
      allow write: if false;
    }

    match /auditoria_accesos/{doc} {
      // Los accesos se registran y consultan desde la API, nunca desde el cliente.
      allow read, write: if false;
    }
  }
}
