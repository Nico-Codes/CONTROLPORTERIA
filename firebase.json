{
  "hosting": {
    "site": "control-rondas-porteria-7ecc7",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://controlporteria.vercel.app/",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "https://controlporteria.vercel.app/",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
